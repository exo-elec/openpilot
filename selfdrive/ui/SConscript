# The C++/Qt UI is gone on both UI branches -- the UI is selfdrive/ui itself,
# a Qt Widgets UI in Python. Nothing here builds a
# `ui` binary any more, so qt_env, the widget/util libraries and the
# assets.qrc -> assets.cc resource compile are all unused; the Python UI
# reads assets from disk. The .ts -> .qm lrelease step below is still needed:
# QTranslator loads the compiled .qm at startup (see main.load_translation).
#
# The installers survive: they are separate raylib programs that have nothing
# to do with the driving UI.
Import('env', 'arch', 'common')

# Compile translations. The Python UI reads .qm files from disk rather than
# from a Qt resource, so this is just lrelease over the .ts sources -- no
# qt_env, no rcc, no moc. lrelease ships in qttools5-dev-tools.
import json
with open(File("translations/languages.json").abspath) as f:
  languages = json.load(f)

ts_files = [f"#selfdrive/ui/translations/{stem}.ts" for stem in languages.values()]
qm_files = [src.replace(".ts", ".qm") for src in ts_files]
translations = env.Command(qm_files, ts_files, "lrelease -silent $SOURCES")
env.NoClean(ts_files)
env.Precious(ts_files)
env.Alias('translations', translations)

if GetOption('extras') and arch != "Darwin":
  raylib_env = env.Clone()
  raylib_env['LIBPATH'] += ['#third_party/raylib/build/raylib']
  raylib_env['LINKFLAGS'].append('-Wl,-strip-debug')

  raylib_libs = common + ["raylib"]
  if arch == "aarch64":
    raylib_libs += ["GLESv2", "wayland-client", "wayland-egl", "EGL"]
  else:
    raylib_libs += ["GL"]

  release = "release3"
  installers = [
    ("openpilot", release),
    ("openpilot_test", f"{release}-staging"),
    ("openpilot_nightly", "nightly"),
    ("openpilot_internal", "nightly-dev"),
  ]

  cont = raylib_env.Command("installer/continue_openpilot.o", "installer/continue_openpilot.sh",
                            "ld -r -b binary -o $TARGET $SOURCE")
  inter = raylib_env.Command("installer/inter_ttf.o", "installer/inter-ascii.ttf",
                             "ld -r -b binary -o $TARGET $SOURCE")
  for name, branch in installers:
    d = {'BRANCH': f"'\"{branch}\"'"}
    if "internal" in name:
      d['INTERNAL'] = "1"

    obj = raylib_env.Object(f"installer/installers/installer_{name}.o", ["installer/installer.cc"], CPPDEFINES=d)
    f = raylib_env.Program(f"installer/installers/installer_{name}", [obj, cont, inter], LIBS=raylib_libs)
    # keep installers small
    assert f[0].get_size() < 1900*1e3, f[0].get_size()
