import os

Import('env', 'envCython', 'arch', 'cereal', 'messaging', 'common', 'gpucommon', 'visionipc', 'transformations')
lenv = env.Clone()
lenvCython = envCython.Clone()

libs = [cereal, messaging, visionipc, gpucommon, common, 'capnp', 'kj', 'pthread']
frameworks = []

# NOTE (audit D33): the upstream OpenCL preprocessing pipeline
# (models/commonmodel.cc + models/commonmodel_pyx.pyx) is NOT built.
# The exo msgq fork removed the CL surface from VisionBuf/visionipc, so the
# Cython extension cannot compile against it; on EOP, frame preprocessing is
# done by inferenced/RGA and modeld uses the python implementation in
# models/commonmodel_pyx.py (numpy). Sources are kept for a future fork
# re-integration.

# Generate model metadata from ONNX (for input/output shapes)
for model_name in ['driving_vision', 'driving_policy']:
  fn = File(f"models/{model_name}").abspath
  script_files = [File(Dir("#selfdrive/modeld").File("get_model_metadata.py").abspath)]
  cmd = f'python3 {Dir("#selfdrive/modeld").abspath}/get_model_metadata.py {fn}.onnx'
  lenv.Command(fn + "_metadata.pkl", [fn + ".onnx"] + script_files, cmd)

# Note: RKNN models are not built here. They should be:
# 1. Converted from ONNX using tools/convert_models_to_rknn.py
# 2. Placed in /data/models/rknn/ or models/rknn/
# 3. Copied to device at /data/models/rknn/
