# Kernel config fragment — required for RTS5411S onboard hub support.
# Merge into your defconfig before building:
#
#   ./scripts/kconfig/merge_config.sh \
#      arch/arm64/configs/rockchip_linux_defconfig \
#      <openpilot>/system/hardware/rk3588/config/dt-overlays/onboard-hub.config
#
CONFIG_USB_ONBOARD_HUB=y
