[Unit]
Description=openpilot (EOP RK3576 / ExoPilot 02M)
After=network-online.target rockchip.service
Wants=network-online.target
Conflicts=dorapilot.service

[Service]
Type=simple
User=root
WorkingDirectory=@@DIR@@
Environment=OPENPILOT_PREFIX=rk3576
EnvironmentFile=-/etc/openpilot/env

ExecStartPre=/bin/bash -c 'source /etc/profile.d/99-rockchip-rk3576-env.sh 2>/dev/null || true'
# 02M's MIPI nodes are not yet mapped to camera roles on real hardware.
# Start the supervisor for UI and diagnostics; v4l2d skips each unconfirmed
# MIPI path while the independent USB camera pipeline remains available.

ExecStart=/bin/bash @@DIR@@/launch_openpilot.sh

Restart=on-failure
RestartSec=5

# Deliberately no LimitAS/LimitRSS. Both are setrlimit values applied to the
# service process and inherited by everything manager forks -- about 45
# supervised daemons -- and neither bounds memory the way it reads:
#
#   LimitAS caps virtual address space, not resident memory. camerad and
#   modeld map large VisionIPC dmabuf regions and the RKNN runtime reserves
#   big VA ranges, so a cap there turns into mmap failing with ENOMEM inside
#   a daemon while the board still has free physical RAM.
#
#   LimitRSS sets RLIMIT_RSS, which Linux has not enforced since 2.4 -- dead
#   configuration that reads like a working memory bound.
#
# Bounding the stack's memory for real means MemoryMax= on the cgroup, which
# needs a number measured on hardware, not one guessed here. The 01M unit
# carried both and has since dropped them too.
OOMScoreAdjust=-100

[Install]
WantedBy=multi-user.target
